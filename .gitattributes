# Chuẩn hóa file văn bản trong Git; mặc định checkout bằng LF.
* text=auto eol=lf

# Script chạy trên Windows dùng CRLF khi checkout.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Giữ nguyên byte của file nhị phân, không chuyển đổi xuống dòng.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.gz binary
*.exe binary
*.dll binary
